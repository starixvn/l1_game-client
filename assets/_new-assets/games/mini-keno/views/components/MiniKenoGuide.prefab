  {
    "__type__": "cc.Label",
    "_name": "",
    "_objFlags": 0,
    "node": {
      "__id__": 142
    },
    "_enabled": true,
    "_materials": [
      {
        "__uuid__": "eca5d2f2-8ef6-41c2-bbe6-f9c79d09c432"
